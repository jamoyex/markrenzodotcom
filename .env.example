# Use the secure OpenAI setup flow to provision OPENAI_API_KEY in .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# `npm run telegram:connect` provides a local form and pairs your owner account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional: set the canonical origin when deploying behind a reverse proxy.
# SITE_URL=https://markrenzo.com
# Persistent local directory for a single Node deployment. Never point tests here.
# PORTFOLIO_DATA_DIR=/absolute/persistent/portfolio-data

# Optional dedicated model for the daily HTML preview builder. Reuses OPENAI_API_KEY.
OPENAI_PREVIEW_MODEL=gpt-5.6-luna

# Leave empty unless a trusted proxy overwrites this header and direct origin access is blocked.
# Allowed values: cf-connecting-ip or x-real-ip. See docs/PREVIEW-BUILDER.md.
PREVIEW_TRUSTED_IP_HEADER=
