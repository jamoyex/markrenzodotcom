{
  "name": "mark-renzo-play-mode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test:guide": "node --import tsx --test src/lib/guide.test.ts",
    "telegram:connect": "node scripts/connect-telegram.mjs",
    "telegram:worker": "node --env-file=.env.local --import tsx scripts/telegram-worker.ts",
    "test:ai": "node --import tsx --test src/lib/site-actions.test.ts src/lib/server/http.test.ts src/lib/server/agent.test.ts src/lib/server/store.test.ts src/lib/server/telegram.test.ts",
    "telegram:notifications": "node --env-file=.env.local --import tsx scripts/notification-worker.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "latest",
    "gsap": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.10",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
